{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "start": "vinext start",
    "test": "npm run build && npm run build:pages && node --experimental-strip-types --test --test-concurrency=1 tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "wrangler types --config dist/server/wrangler.json .wrangler/worker-configuration.d.ts && tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "wrangler": "4.151.3"
  },
  "type": "module",
  "overrides": {
    "undici@>=7 <8": "7.30.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
